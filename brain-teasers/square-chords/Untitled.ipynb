   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\int\\limits_{0}^{1} \\begin{cases} \\frac{i \\left(1 - x\\right) \\left(x - 1\\right)^{3}}{2 \\left(\\left(x - 1\\right)^{2} - 1\\right)^{\\frac{3}{2}}} - \\frac{i \\left(1 - x\\right) \\left(x - 1\\right)}{2 \\left(\\left(x - 1\\right)^{2} - 1\\right)^{\\frac{3}{2}}} + \\frac{3 i \\left(x - 1\\right)^{2}}{2 \\sqrt{\\left(x - 1\\right)^{2} - 1}} - \\frac{i}{\\sqrt{\\left(x - 1\\right)^{2} - 1}} & \\text{for}\\: \\left(x - 1\\right)^{2} > 1 \\\\\\frac{\\left(1 - x\\right) \\left(x - 1\\right)}{2 \\sqrt{1 - \\left(x - 1\\right)^{2}}} + \\frac{\\sqrt{1 - \\left(x - 1\\right)^{2}}}{2} + \\frac{1}{2 \\sqrt{1 - \\left(x - 1\\right)^{2}}} & \\text{otherwise} \\end{cases}\\, dx$"
      ],
      "text/plain": [
       "Integral(Piecewise((I*(1 - x)*(x - 1)**3/(2*((x - 1)**2 - 1)**(3/2)) - I*(1 - x)*(x - 1)/(2*((x - 1)**2 - 1)**(3/2)) + 3*I*(x - 1)**2/(2*sqrt((x - 1)**2 - 1)) - I/sqrt((x - 1)**2 - 1), (x - 1)**2 > 1), ((1 - x)*(x - 1)/(2*sqrt(1 - (x - 1)**2)) + sqrt(1 - (x - 1)**2)/2 + 1/(2*sqrt(1 - (x - 1)**2)), True)), (x, 0, 1))"
      ]
     },
     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    }
